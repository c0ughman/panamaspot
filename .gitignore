# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Raw / source image assets — only optimised .webp files are committed.
# These originals stay on disk for re-running scripts but are never deployed.
# Note: negation (!*.webp) only works because we target files, not whole dirs.
public/images/**/*.jpg
public/images/**/*.JPG
public/images/**/*.jpeg
public/images/**/*.HEIC
public/images/**/*.heic
public/images/**/*.png
public/images/**/*.PNG
public/images/*.jpg
public/images/*.JPG
public/images/*.jpeg
public/images/*.HEIC
public/images/*.heic
# Raw camera rolls
public/images/boquete/IMG_*
public/images/el-valle/IMG_*
# Scratch / stray directory at repo root (the video)
/boquete/
# Example / draft HTML files
public/articles/*-EXAMPLE.html
public/es/articles/*-EXAMPLE.html

# Raw source images dropped in for the El Valle funnel (working folder)
/evalley el valle/
