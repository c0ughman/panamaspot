# Copy to .env.local for local builds. On Netlify these are set in
# Site configuration → Environment variables instead.

NEXT_PUBLIC_SITE_URL=https://panamaspot.com

# GA4 measurement ID (Admin → Data streams → Web). Format: G-XXXXXXXXXX.
# When unset the build still succeeds, but ships with no analytics.
NEXT_PUBLIC_GA_ID=
